{
  "name": "pj1-svg-editor",
  "version": "0.1.0",
  "private": true,
  "description": "PJ1 Phase 1 and 2: extensible object-oriented TypeScript SVG editor",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "npm run build --silent && node dist/src/cli/main.js",
    "demo": "npm run build --silent && node scripts/replay.mjs",
    "test": "npm run build --silent && node scripts/test.mjs",
    "test:coverage": "npm run build --silent && node scripts/test.mjs --coverage",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && npm test",
    "build:extension": "node scripts/build-extension.mjs",
    "test:plugins": "npm run build --silent && node scripts/check-plugin-tests.mjs && node scripts/test.mjs --plugins-only",
    "test:plugin": "npm run build --silent && node scripts/test.mjs --plugin",
    "verify:compatibility": "npm run build --silent && node scripts/verify-compatibility.mjs",
    "verify:git": "node scripts/verify-git-boundaries.mjs",
    "metrics": "node scripts/metrics.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "saxes": "^6.0.0",
    "transformation-matrix": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.3"
  }
}
